# Copy to .env.local for local development. On Vercel, add the same names
# under Project Settings > Environment Variables. Never commit real values.

# --- Sign-in (one-time code by email) ---

# Signs the sign-in cookies. At least 32 characters; make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
AUTH_SECRET=replace-with-a-long-random-string

# Mailgun sends the codes. Without these, local development prints the email
# to the server console instead; production refuses to send.
MAILGUN_API_KEY=replace-me
MAILGUN_DOMAIN=mercive.com
MAILGUN_API_BASE=https://api.eu.mailgun.net
# Optional. Default: Mercive <noreply@MAILGUN_DOMAIN>
# MAIL_FROM=Mercive <noreply@mercive.com>

# Email domains that may sign in, comma separated. Default: mercive.com
# LOGIN_DOMAINS=mercive.com

# The hosts: they steer the slides, unwrap answers and keep score.
# Default: tobias.bech@mercive.com, martin.krogh@mercive.com, clara.lund@mercive.com
# MASTER_EMAILS=

# --- Shared quiz state ---
# Upstash Redis (add it from the Vercel Marketplace; it sets these two).
# Required on Vercel. Locally, leave them out and the state lives in .data/.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
